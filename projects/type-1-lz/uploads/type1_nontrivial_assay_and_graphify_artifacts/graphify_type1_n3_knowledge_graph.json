{
  "metadata": {
    "title": "Type-1 N=3 Landau-Zener knowledge graph",
    "created": "2026-05-19T21:49:12.438047Z",
    "version": "1.0",
    "description": "Graphify-ready graph of current objects, theorems, assays, and falsifications."
  },
  "nodes": [
    {
      "id": "params",
      "label": "Type-1 parameters {epsilon,gamma,a}",
      "type": "input",
      "status": "baseline",
      "note": "Real ordered epsilon, nonzero gamma, slopes a."
    },
    {
      "id": "p",
      "label": "p(lambda)=prod(lambda-epsilon)",
      "type": "polynomial",
      "status": "baseline",
      "note": "Family invariant."
    },
    {
      "id": "n",
      "label": "n(lambda)=sum gamma^2 prod(lambda-eps)",
      "type": "polynomial",
      "status": "baseline",
      "note": "Family invariant."
    },
    {
      "id": "m",
      "label": "m_H(lambda)=sum a gamma^2 prod(lambda-eps)",
      "type": "polynomial",
      "status": "member-dependent",
      "note": "Encodes chosen H."
    },
    {
      "id": "q",
      "label": "q_u(lambda)=u p(lambda)-n(lambda)",
      "type": "spectral polynomial",
      "status": "baseline",
      "note": "Roots define sheets."
    },
    {
      "id": "lambda_roots",
      "label": "lambda_i(u)",
      "type": "sheets",
      "status": "baseline",
      "note": "Three roots of q_u."
    },
    {
      "id": "E",
      "label": "E_i=m(lambda_i)/p(lambda_i)",
      "type": "energies",
      "status": "baseline",
      "note": "Adiabatic energies."
    },
    {
      "id": "Gamma",
      "label": "Gamma_i=delta_i/sqrt(Sigma_i^(2))",
      "type": "normalization",
      "status": "baseline",
      "note": "Eigenvector normalization."
    },
    {
      "id": "Sij",
      "label": "S_ij=Gamma_i Gamma_j/(lambda_i-lambda_j)",
      "type": "transport connection",
      "status": "baseline",
      "note": "Antisymmetric, smooth through u=0."
    },
    {
      "id": "ad_ode",
      "label": "Gauged adiabatic ODE",
      "type": "dynamics",
      "status": "baseline",
      "note": "f_i prime = -sum S_ij f_j + i(E_i-E_x) f_i."
    },
    {
      "id": "P",
      "label": "Transition matrix P_{x->j}=|f_j(+infty)|^2",
      "type": "observable",
      "status": "baseline",
      "note": "Primary benchmark."
    },
    {
      "id": "Hmat",
      "label": "Type-1 matrix H(u)",
      "type": "matrix realization",
      "status": "baseline",
      "note": "Has off-diagonal Cauchy form and eigenvectors gamma/(lambda-epsilon)."
    },
    {
      "id": "quotient",
      "label": "E_u=C[lambda]/(q_u)",
      "type": "quotient-ring bundle",
      "status": "formalized",
      "note": "Rank-three fiber algebra."
    },
    {
      "id": "su",
      "label": "s_u inverse of p mod q_u",
      "type": "quotient-ring object",
      "status": "formalized",
      "note": "p s_u == 1 mod q_u."
    },
    {
      "id": "Rcarrier",
      "label": "Reduced carrier [R]",
      "type": "state representation",
      "status": "formalized",
      "note": "f_i=Gamma_i R(lambda_i;u)."
    },
    {
      "id": "Hx",
      "label": "H_x multiplication by red((m-E_x p)s_u)",
      "type": "operator",
      "status": "formalized",
      "note": "Reduced quotient-ring Hamiltonian."
    },
    {
      "id": "compact_ode",
      "label": "Compact quotient-ring ODE",
      "type": "dynamics",
      "status": "formalized",
      "note": "partial_u[R]=i[(m-E_x p)s_u R]."
    },
    {
      "id": "cauchy_frame",
      "label": "Cauchy/pole frame V_i\u03b1",
      "type": "frame",
      "status": "baseline",
      "note": "V_i\u03b1=Gamma_i gamma_alpha/(lambda_i-epsilon_alpha)."
    },
    {
      "id": "flat_solution",
      "label": "E=0 flat solution",
      "type": "solution",
      "status": "baseline",
      "note": "f_i=Gamma_i gamma_x/(lambda_i-epsilon_x)."
    },
    {
      "id": "pair_spaces",
      "label": "Pair spaces (u,Delta),(u,S),(Delta,S)",
      "type": "geometry",
      "status": "formalized",
      "note": "Directly computable local pair spaces."
    },
    {
      "id": "Ainv",
      "label": "A invariant",
      "type": "invariant",
      "status": "formalized",
      "note": "A=1/2(3 tr H^2 - (tr H)^2)."
    },
    {
      "id": "Ddisc",
      "label": "D discriminant",
      "type": "invariant",
      "status": "formalized",
      "note": "D=prod pair gaps squared."
    },
    {
      "id": "gap_cubic",
      "label": "Gap cubic y^3-2Ay^2+A^2y-D=0",
      "type": "algebraic curve",
      "status": "formalized",
      "note": "y=Delta^2."
    },
    {
      "id": "gap_sextic",
      "label": "Gap sextic Delta^6-2A Delta^4 + A^2 Delta^2 - D=0",
      "type": "algebraic relation",
      "status": "formalized",
      "note": "Sparse universal degree-six relation."
    },
    {
      "id": "resolvent",
      "label": "Resolvent M^3-3AM+B=0",
      "type": "algebraic curve",
      "status": "formalized",
      "note": "Delta^2=(4A-M^2)/3."
    },
    {
      "id": "ordinary_sector",
      "label": "Ordinary pairwise WKB sector",
      "type": "exact-WKB sector",
      "status": "partly solved",
      "note": "Algebraic Abelian differentials on low-complexity cover."
    },
    {
      "id": "gxi",
      "label": "Complementary quadratic g_xi(z)",
      "type": "algebraic object",
      "status": "formalized",
      "note": "Roots are complementary pair to spectator xi."
    },
    {
      "id": "Q4",
      "label": "Q4=Disc_z g_lambda",
      "type": "quartic",
      "status": "formalized",
      "note": "Controls phase square root and ordinary Q4 windows."
    },
    {
      "id": "LH",
      "label": "L_H(lambda)",
      "type": "linear factor",
      "status": "formalized",
      "note": "Member-dependent exact crossing/gap factor."
    },
    {
      "id": "W4",
      "label": "W4=n p_prime - n_prime p",
      "type": "quartic",
      "status": "formalized",
      "note": "Controls transport ramification and critical points of u=n/p."
    },
    {
      "id": "kappaS",
      "label": "kappa_S=-Res(p,n)",
      "type": "normalization",
      "status": "formalized",
      "note": "Positive for real ordered Type-1 data."
    },
    {
      "id": "ycoord",
      "label": "y=Q4 L_H^2 / p^2",
      "type": "coordinate",
      "status": "formalized",
      "note": "Sign-invariant phase coordinate."
    },
    {
      "id": "rcoord",
      "label": "r=W4/L_H^4",
      "type": "coordinate",
      "status": "formalized",
      "note": "Sign-invariant transport coordinate."
    },
    {
      "id": "Sminus2",
      "label": "S^{-2}=Q4^2 W4/(kappa_S p^4)",
      "type": "coordinate",
      "status": "formalized",
      "note": "Compatible transport square."
    },
    {
      "id": "SigmaY",
      "label": "Sigma_Y phase curve",
      "type": "curve",
      "status": "formalized",
      "note": "Spectrum of Y; y cubic."
    },
    {
      "id": "SigmaR",
      "label": "Sigma_R transport curve",
      "type": "curve",
      "status": "formalized",
      "note": "Spectrum of R; ramifies at W4."
    },
    {
      "id": "Ccover",
      "label": "Common cover C=Sigma_Y x_u Sigma_R",
      "type": "cover",
      "status": "formalized",
      "note": "Normalizes to P^1_lambda."
    },
    {
      "id": "Chat",
      "label": "Spinor cover Chat, rho^2=kappa_S/r",
      "type": "cover",
      "status": "formalized",
      "note": "Restores transport square root."
    },
    {
      "id": "omega",
      "label": "omega=sqrt(y) du",
      "type": "one-form",
      "status": "formalized",
      "note": "Phase differential."
    },
    {
      "id": "eta",
      "label": "eta=S du=rho du/y",
      "type": "one-form",
      "status": "formalized",
      "note": "Transport differential."
    },
    {
      "id": "halfform",
      "label": "Half-form amplitude vector Psi",
      "type": "frame/section",
      "status": "formalized",
      "note": "Packages f_i on lifted geometry."
    },
    {
      "id": "Yop",
      "label": "Y multiplication by Q4 L_H^2/p^2",
      "type": "operator",
      "status": "formalized",
      "note": "Spectrum gives y=Delta^2."
    },
    {
      "id": "Rop",
      "label": "R multiplication by W4/L_H^4",
      "type": "operator",
      "status": "formalized",
      "note": "Spectrum gives r."
    },
    {
      "id": "commuting_triple",
      "label": "Commuting triple (H_x,Y,R)",
      "type": "operator system",
      "status": "formalized",
      "note": "Turns pair sectors into common eigenlines."
    },
    {
      "id": "projectors",
      "label": "Spectral projectors Pi_alpha",
      "type": "operator",
      "status": "formalized",
      "note": "Project onto Rop eigenlines away from C_R."
    },
    {
      "id": "gluing",
      "label": "Canonical gluing theorem",
      "type": "theorem",
      "status": "proved",
      "note": "No independent pair-sector gluing on regular set."
    },
    {
      "id": "CR",
      "label": "Transport discriminant C_R=u(W4=0)",
      "type": "ramification locus",
      "status": "formalized",
      "note": "Only possible selector/gluing ambiguity locus."
    },
    {
      "id": "selector_criterion",
      "label": "Selector criterion: W4 ramification + phase resonance",
      "type": "criterion",
      "status": "formalized",
      "note": "Im(e^{-i theta} S_{+-})=0."
    },
    {
      "id": "local_airy",
      "label": "Local Airy/Langer model",
      "type": "local model",
      "status": "formalized",
      "note": "At simple phase-active transport ramification."
    },
    {
      "id": "torus_theorem",
      "label": "Exact two-sheet torus theorem",
      "type": "theorem",
      "status": "proved in notes",
      "note": "Canonical local gauge is torus-valued."
    },
    {
      "id": "phase_recurrence",
      "label": "Lagrange-Buermann phase recurrence",
      "type": "recurrence",
      "status": "proved in notes",
      "note": "D_{2m+1}(H) affine-linear in L_H(v), L_H prime(v)."
    },
    {
      "id": "selector_multiplier",
      "label": "Scalar selector multiplier s_BS",
      "type": "local multiplier",
      "status": "proved in notes",
      "note": "s=-i exp(2 Theta_v)."
    },
    {
      "id": "selector_block",
      "label": "Embedded selector block J_v",
      "type": "local block",
      "status": "proved in notes",
      "note": "I+s N on active 2 plus spectator identity."
    },
    {
      "id": "global_insertion",
      "label": "Exact global selector insertion rule",
      "type": "theorem",
      "status": "proved in notes",
      "note": "T_out J T_in, independent of overlap."
    },
    {
      "id": "continuation_functor",
      "label": "Continuation functor",
      "type": "functor",
      "status": "partly formalized",
      "note": "Path groupoid to GL_3(C), ordered products."
    },
    {
      "id": "Q4_window",
      "label": "Projected conjugate-pair Q4 window W_X",
      "type": "window object",
      "status": "target",
      "note": "Full 3x3 continuation object, not point block."
    },
    {
      "id": "Med",
      "label": "Median Med(T+,T-)",
      "type": "operation",
      "status": "target",
      "note": "T+((T-)^{-1}T+)^{-1/2}."
    },
    {
      "id": "edge_D",
      "label": "Edge propagators D_e",
      "type": "propagator",
      "status": "target",
      "note": "Regular propagation between windows."
    },
    {
      "id": "Pi_plus",
      "label": "Endpoint permutation Pi_+",
      "type": "permutation",
      "status": "validated",
      "note": "[[0,0,1],[1,0,0],[0,1,0]]."
    },
    {
      "id": "Pi_minus",
      "label": "Endpoint permutation Pi_-",
      "type": "permutation",
